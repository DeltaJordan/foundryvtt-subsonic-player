{{formGroup fields.serverUrl value=config.serverUrl localize=true}}
{{formGroup fields.username value=config.username localize=true}}
<div class="form-group">
	<label for="{{rootId}}-subsonicPassword">
		{{localize "subsonic.credentials.password.label"}}
	</label>
	<div class="form-fields">
		<input
			type="password"
			name="password"
			id="{{rootId}}-subsonicPassword"
			value="{{config.password}}"
			required
		/>
	</div>
	<p class="hint">
		{{localize "subsonic.credentials.password.hint"}}
	</p>
</div>